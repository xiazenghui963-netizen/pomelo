# ===== 青柚 AI 环境变量示例 =====
# 复制本文件为 .env 并填入真实配置

# 基础
APP_NAME=青柚AI
DEBUG=True
SECRET_KEY=请替换为随机字符串
TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./pomelo.db

# ===== 大模型（OpenAI 兼容协议，如 DeepSeek / 通义 / 智谱）=====
# 全局默认模型：仅当当前用户没有配置对应类型（text/image）的默认模型时使用
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 模拟模式（最高优先级）：开启后忽略用户配置与全局默认，所有大模型调用返回模拟数据（skill 走 mock 分支）
ENABLE_AI_SIMULATE=False

# ===== 图像理解 VLM（OpenAI 兼容 /messages content image_url，如 qwen-vl 等）=====
# 未配置时自动降级到 OCR
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# ===== 腾讯云 OCR 文字识别 =====
OCR_SECRET_ID=
OCR_SECRET_KEY=
OCR_REGION=ap-beijing

# ===== 图片处理 =====
# 上传截图仅在内存中暂存用于 OCR/VLM 识别，处理完成立即丢弃，不写磁盘、不存云存储
SESSION_IMAGE_TTL=900

# ===== AI 绘图（OpenAI 兼容 images API，如通义/智谱绘图）=====
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# ===== 点数策略 =====
INITIAL_POINTS=100
FREE_DAILY_POINTS=20
MEMBER_DAILY_POINTS=50
SIMILARITY_THRESHOLD=0.35
MATERIAL_MAX_SELECT=3
MATERIAL_MAX_CHARS=2000
UPLOAD_MAX_MB=15

# ===== 系统 =====
TASK_WORKERS=2
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# 种子管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456